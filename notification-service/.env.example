# Heliobond Notification Service — Environment Configuration
# Copy to .env and fill in your values.

# ── Stellar Network ───────────────────────────────────────────────────────

# Soroban RPC endpoint used to poll on-chain events.
# Default: https://soroban-testnet.stellar.org (testnet)
# Format: URL (https://…)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase that identifies the Stellar network.
# Default: Test SDF Network ; September 2015 (testnet)
# Format: string — must match the network your contracts are deployed on
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Deployed Contract IDs ─────────────────────────────────────────────────

# Stellar contract address of the ProjectRegistry contract.
# Required — the service will not start without this.
# Format: C… (Stellar contract address, 56 characters)
REGISTRY_CONTRACT_ID=

# Stellar contract address of the InvestmentVault contract (optional).
# Format: C… (Stellar contract address, 56 characters)
VAULT_CONTRACT_ID=

# ── Database ──────────────────────────────────────────────────────────────

# Path to the SQLite database file. Created automatically on first run.
# Default: ./data/notifications.db
# Format: file path (relative or absolute)
DB_PATH=./data/notifications.db

# ── Polling ───────────────────────────────────────────────────────────────

# How often (in ms) the listener polls Soroban RPC for new events.
# Default: 30000 (30 seconds)
# Format: positive integer
POLL_INTERVAL_MS=30000

# ── Email Transport (optional — omit all to disable email) ────────────────

# Sender address for outgoing notification emails.
# Format: valid email address
FROM_EMAIL=notifications@heliobond.io

# SMTP server hostname. Leave blank to disable email notifications.
# Format: hostname or IP
SMTP_HOST=

# SMTP server port.
# Default: 587 (STARTTLS)
# Format: integer
SMTP_PORT=587

# Whether to use TLS from the start (true) or STARTTLS (false).
# Default: false
# Format: true | false
SMTP_SECURE=false

# SMTP authentication username.
# Format: string
SMTP_USER=

# SMTP authentication password.
# Format: string
SMTP_PASS=

# ── REST API ──────────────────────────────────────────────────────────────

# Port the HTTP health/preference API listens on.
# Default: 3000
# Format: integer (1–65535)
API_PORT=3000
